# ---------------------------------------------------------------------------
# Velora Wears — root environment template.
#
# The STOREFRONT does not use this file. Its config lives in
# storefront/.env.example (VITE_ prefixed, public by design).
#
# This file documents the values used by tooling that talks to Supabase with
# elevated rights. None of it is ever shipped to the browser.
# ---------------------------------------------------------------------------

# Personal access token for the Supabase CLI and Management API.
# Create at https://supabase.com/dashboard/account/tokens
# Grants full control of your Supabase account — treat it like a password.
SUPABASE_ACCESS_TOKEN=

# The project this repository deploys to (Project Settings -> General).
SUPABASE_PROJECT_REF=

# Database password, for `supabase db push`. Set when the project was created.
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# NOT NEEDED HERE: the service role key.
#
# Edge Functions receive SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from the
# platform automatically. There is no reason to copy that key onto a laptop,
# and every reason not to — it bypasses row level security completely.
# ---------------------------------------------------------------------------
