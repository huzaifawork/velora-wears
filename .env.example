# ---------------------------------------------------------------------------
# Velora Wears — environment template
#
# Copy to .env.local and fill in real values. Never commit the filled-in file.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Firebase Realtime Database instance URL (from Firebase console > Realtime Database)
FIREBASE_DATABASE_URL=https://<your-project>-default-rtdb.<region>.firebasedatabase.app

# Firebase project ID (optional; inferred from the service account when omitted)
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Admin SDK credentials
#
# Path to the service account JSON file that you keep LOCALLY. The file itself
# is gitignored — only this path lives in config. Either variable works;
# FIREBASE_SERVICE_ACCOUNT_PATH takes precedence.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/velora-wears-firebase-adminsdk.json
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Local emulator (optional) — set when running `npm run emulators`
# ---------------------------------------------------------------------------
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
