# ---------------------------------------------------------------------------
# Velora Wears — root environment template
#
# The STOREFRONT does not use this file. Its config lives in
# storefront/.env.example (VITE_ prefixed, public by design).
#
# This file documents the server-side values used by Cloud Functions and by
# any local script that talks to Firebase with the Admin SDK.
# ---------------------------------------------------------------------------

# Realtime Database instance URL
FIREBASE_DATABASE_URL=https://<your-project>-default-rtdb.<region>.firebasedatabase.app

# Firebase project ID
FIREBASE_PROJECT_ID=

# Path to the Admin SDK service account JSON kept LOCALLY.
# The file itself is gitignored — only this path lives in config.
# Deployed Cloud Functions do NOT need this; they use the runtime service account.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/<your-key>.json
GOOGLE_APPLICATION_CREDENTIALS=

# Local emulator (optional)
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
