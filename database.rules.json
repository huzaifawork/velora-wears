{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },

    "productSummaries": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["slug", "categorySlug", "createdAt", "searchText", "price"]
    },

    "products": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["slug", "categorySlug", "createdAt"]
    },

    "categories": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["sortOrder"]
    },

    "settings": {
      "public": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      },
      "private": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },

    "reviews": {
      ".read": true,
      ".write": false,
      "$productId": {
        ".indexOn": ["createdAt", "hidden"]
      }
    },

    "orders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false,
      ".indexOn": ["createdAt", "status"]
    }
  }
}
