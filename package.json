{
  "name": "velora-wears",
  "version": "0.1.0",
  "private": true,
  "description": "Velora Wears - e-commerce clothing store. Storefront (React + Vite) and admin dashboard share one Firebase Realtime Database.",
  "workspaces": [
    "storefront",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace storefront",
    "build": "npm run build --workspace storefront",
    "preview": "npm run preview --workspace storefront",
    "lint": "npm run lint --workspace storefront",
    "typecheck": "npm run typecheck --workspace storefront",
    "emulators": "firebase emulators:start --only database,functions",
    "deploy:rules": "firebase deploy --only database",
    "deploy:functions": "firebase deploy --only functions"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
