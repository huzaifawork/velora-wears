# ---------------------------------------------------------------------------
# Storefront — Firebase WEB config.
#
# These values are compiled into the browser bundle and are PUBLIC by design.
# That is how the Firebase web SDK works; they are not secrets. Security is
# enforced by database.rules.json, not by hiding these.
#
# Get real values with:
#   firebase apps:sdkconfig WEB --project velora-wears
#
# Copy to storefront/.env.local and fill in.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
