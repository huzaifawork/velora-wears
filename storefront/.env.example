# ---------------------------------------------------------------------------
# Storefront — Supabase config.
#
# These values are compiled into the browser bundle and are PUBLIC by design.
# That is what the anon key is for. Security is enforced by ROW LEVEL SECURITY
# in the database, not by hiding these.
#
# THE SERVICE ROLE KEY MUST NEVER GO IN THIS FILE. It bypasses row level
# security entirely and belongs only in Edge Functions, where Supabase injects
# it automatically.
#
# Find these under Project Settings -> API in the Supabase dashboard.
#
# Copy to storefront/.env.local and fill in.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Where the catalog is read from.
#
#   demo      - the throwaway catalog in src/lib/demoData.ts (current default)
#   supabase  - the live Postgres database
#
# The database schema is deployed but DELIBERATELY EMPTY: no mock data is ever
# written to it. Switch this to `supabase` once the admin dashboard has created
# real products, otherwise the storefront renders an empty shop.
#
# Vite inlines this at BUILD time, so changing it needs a rebuild/redeploy.
# ---------------------------------------------------------------------------

VITE_DATA_SOURCE=demo
