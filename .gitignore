# dependencies
node_modules/

# build output
dist/
build/
# Cloud Functions compile to functions/lib. Scoped on purpose: a bare `lib/`
# also swallowed storefront/src/lib, so the read layer was never committed.
functions/lib/
*.tsbuildinfo
.vite/

# environment — never commit real values
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Firebase Admin SDK service account keys — NEVER commit these
# ---------------------------------------------------------------------------
*serviceAccountKey.json
*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
secrets/
credentials/

# firebase tooling
.firebase/
firebase-debug.log*
firebase-debug.*.log*
database-debug.log*
ui-debug.log*

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# editors / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# vercel
.vercel
