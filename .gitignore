# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo
.vite/

# environment — never commit real values
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Credentials — NEVER commit these. THIS REPOSITORY IS PUBLIC.
#
# The Supabase service role key and personal access tokens (sbp_...) grant
# full control. They belong in the Supabase platform and in your shell, never
# in a file here.
# ---------------------------------------------------------------------------
*serviceAccountKey.json
*service-account*.json
*serviceAccount*.json
secrets/
credentials/

# supabase cli local state
supabase/.temp/
supabase/.branches/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# editors / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# vercel
.vercel
